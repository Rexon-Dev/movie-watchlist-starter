# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Kunci rahasia untuk menandatangani JWT (string acak panjang)
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-panjang

# API key Gemini dari https://aistudio.google.com/apikey
GEMINI_API_KEY=isi-api-key-gemini-kamu

# Nama model Gemini. Jika error 404 / model tidak ditemukan, ganti ke model lain
# yang tersedia di Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash
